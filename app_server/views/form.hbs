<!-- New listing form -->
<section class="py-4 py-xl-5 min-vh-100">
    <div class="container-fluid d-flex justify-content-center px-5">
        <form
            action="/api/rentals"
            method="POST"
            class="text-center border rounded border-0 shadow-lg p-5"
            style="max-width: 700px;"
            id="rentalForm"
        >
            <h2 class="fw-bold mb-3">List Your Rental</h2>
            <h5 class="mb-4">Fill out the form below to submit your rental
                listing</h5>
            <!-- Property information -->
            <div class="row gy-3 row-cols-1 text-start align-items-end">
                <div class="col">
                    <label class="form-label" for="title">Title*</label>
                    <input
                        class="form-control"
                        type="text"
                        id="title"
                        maxlength="27"
                        required=""
                        name="title"
                        placeholder="Enter a short title for your rental"
                    />
                </div>
                <div class="col">
                    <label
                        class="form-label"
                        for="description"
                    >Description</label>
                    <textarea
                        class="form-control"
                        id="description"
                        required=""
                        name="description"
                        placeholder="Describe your property, amenities, and features"
                    ></textarea>
                </div>
                <div class="col">
                    <label class="form-label" for="image">Image</label>
                    <input
                        class="form-control"
                        type="text"
                        name="image"
                        placeholder="image.jpg"
                    />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="propertyType">Property Type*</label>
                    <select
                        class="form-select"
                        id="propertyType"
                        required=""
                        name="propertyType"
                    >
                        <option value="Room" selected="">Room</option>
                        <option value="Entire Property">Entire property</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="rentAmount">Rent Amount*</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input
                            class="form-control"
                            type="text"
                            id="rentAmount"
                            required=""
                            name="rentAmount"
                            placeholder="0"
                        />
                        <span class="input-group-text">/ month</span>
                    </div>
                </div>
                <div class="col-md-4"><label
                        class="form-label"
                        for="rooms"
                    >Number of Rooms*</label><input
                        class="form-control"
                        type="number"
                        id="rooms"
                        min="1"
                        step="1"
                        max="5"
                        required=""
                        value="1"
                        name="rooms"
                    /></div>
                <div class="col">
                    <label class="form-label" for="location">Location*</label>
                    <input
                        class="form-control"
                        type="text"
                        id="location"
                        maxlength="27"
                        required=""
                        name="location"
                        placeholder="City, State"
                    />
                </div>
                <div class="col">
                    <h5 class="fw-bold">Contact Information</h5>
                </div>
                <!-- Contact information -->
                <div class="col">
                    <label class="form-label" for="contactName">Name*</label>
                    <input
                        class="form-control"
                        type="text"
                        id="contactName"
                        maxlength="27"
                        required=""
                        name="contactName"
                    />
                </div>
                <div class="col">
                    <label class="form-label" for="contactEmail">Email Address*</label>
                    <input
                        class="form-control"
                        type="email"
                        inputmode="email"
                        id="contactEmail"
                        name="contactEmail"
                    />
                </div>
                <div class="col">
                    <label class="form-label" for="contactPhone">Phone Number</label>
                    <input
                        class="form-control"
                        type="tel"
                        inputmode="tel"
                        id="contactPhone"
                        name="contactPhone"
                        placeholder="123-456-7890"
                    />
                </div>
                <div class="col text-center">
                    <button
                        class="btn btn-outline-success btn-lg fw-semibold border-3"
                        type="submit"
                    >Submit Listing</button>
                </div>
            </div>
        </form>
    </div>
</section>

